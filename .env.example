# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable analytics.
VITE_GA_MEASUREMENT_ID=

# Resend (https://resend.com) API key used to email the team whenever a visitor
# submits the contact form or the chat assistant's lead-capture card. Free tier
# is enough to start. Leave unset to disable email notifications (the contact
# form / chat still work via WhatsApp either way).
RESEND_API_KEY=

# Optional: sender shown on the notification email. Resend lets you send from
# onboarding@resend.dev with no setup; switch to your own domain once it's
# verified in Resend (e.g. "Kiji Technology Website <leads@kijitechnology.in>").
RESEND_FROM_EMAIL=

# Optional: where lead notification emails are sent. Defaults to the contact
# email already configured in src/components/site/data.ts (kijitechnology@gmail.com).
LEAD_NOTIFY_EMAIL=
